<section class="px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-cyan-200">Natijalar</p>
        <h1 class="mt-3 text-4xl font-black sm:text-5xl"><span class="gradient-text">Saqlangan aniqlashlar</span></h1>
      </div>
      <a href="/demo" class="gradient-btn inline-flex items-center justify-center rounded-full px-6 py-3 font-black text-white">Yangi demo</a>
    </div>

    <% if (typeof error !== 'undefined') { %>
      <div class="mb-6 rounded-[8px] border border-red-400/30 bg-red-500/10 p-4 font-semibold text-red-100"><%= error %></div>
    <% } %>

    <div class="grid gap-5 md:grid-cols-3">
      <div class="glass rounded-[8px] p-6">
        <p class="text-sm text-slate-300">Jami sessiyalar</p>
        <p class="mt-2 text-4xl font-black"><%= stats.total %></p>
      </div>
      <div class="glass rounded-[8px] p-6">
        <p class="text-sm text-slate-300">Eng ko'p holat</p>
        <p class="mt-2 text-4xl font-black gradient-text"><%= stats.topPose %></p>
      </div>
      <div class="glass rounded-[8px] p-6">
        <p class="text-sm text-slate-300">Bugungi sessiyalar</p>
        <p class="mt-2 text-4xl font-black"><%= stats.today %></p>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="glass rounded-[8px] p-6">
        <h2 class="mb-5 text-2xl font-black">Holatlar chastotasi</h2>
        <div class="h-72">
          <canvas id="poseChart"></canvas>
        </div>
      </section>

      <section class="glass overflow-hidden rounded-[8px]">
        <div class="border-b border-white/10 p-6">
          <h2 class="text-2xl font-black">Tarix jadvali</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[720px] text-left">
            <thead class="bg-white/5 text-sm text-cyan-100">
              <tr>
                <th class="px-5 py-4">Sana</th>
                <th class="px-5 py-4">Holat</th>
                <th class="px-5 py-4">Davomiylik</th>
                <th class="px-5 py-4">Tavsiya</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              <% if (results.length === 0) { %>
                <tr>
                  <td colspan="4" class="px-5 py-8 text-center text-slate-300">Hali natija saqlanmagan.</td>
                </tr>
              <% } %>
              <% results.forEach((item) => { %>
                <tr class="transition hover:bg-white/5">
                  <td class="px-5 py-4 text-slate-300"><%= new Date(item.timestamp).toLocaleString('uz-UZ') %></td>
                  <td class="px-5 py-4 font-black text-cyan-100"><%= item.pose %></td>
                  <td class="px-5 py-4"><%= formatDuration(item.duration) %></td>
                  <td class="px-5 py-4 text-slate-300"><%= item.advice %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const poseCounts = <%- JSON.stringify(poseCounts) %>;
  const labels = ["Turgan", "O'tirgan", "Yiqilgan", "Yurmoqda"];
  const values = labels.map((label) => poseCounts[label] || 0);
  const ctx = document.getElementById('poseChart');

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Holatlar soni',
        data: values,
        backgroundColor: ['#00d4ff', '#2dd4bf', '#f43f5e', '#7b2ff7'],
        borderRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          labels: { color: '#edf8ff' }
        }
      },
      scales: {
        x: {
          ticks: { color: '#cbd5e1' },
          grid: { color: 'rgba(255,255,255,0.08)' }
        },
        y: {
          beginAtZero: true,
          ticks: {
            color: '#cbd5e1',
            precision: 0
          },
          grid: { color: 'rgba(255,255,255,0.08)' }
        }
      }
    }
  });
</script>
