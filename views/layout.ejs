<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | PoseAI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg: #0f0f1a;
      --card: rgba(26, 26, 46, 0.72);
      --line: rgba(0, 212, 255, 0.24);
      --cyan: #00d4ff;
      --violet: #7b2ff7;
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 15% 20%, rgba(0, 212, 255, 0.18), transparent 28%),
        radial-gradient(circle at 85% 10%, rgba(123, 47, 247, 0.22), transparent 30%),
        linear-gradient(135deg, #0f0f1a 0%, #121225 48%, #0b1021 100%);
      color: #edf8ff;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.22;
      background-image:
        linear-gradient(rgba(0, 212, 255, 0.16) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 212, 255, 0.16) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.9), transparent 85%);
    }

    .glass {
      background: var(--card);
      border: 1px solid rgba(255, 255, 255, 0.10);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(18px);
    }

    .gradient-text {
      background: linear-gradient(90deg, var(--cyan), var(--violet));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .gradient-btn {
      background: linear-gradient(90deg, var(--cyan), var(--violet));
      box-shadow: 0 12px 30px rgba(0, 212, 255, 0.22);
      transition: transform 180ms ease, box-shadow 180ms ease, filter 180ms ease;
    }

    .gradient-btn:hover {
      transform: translateY(-2px);
      filter: brightness(1.08);
      box-shadow: 0 18px 42px rgba(123, 47, 247, 0.32);
    }

    .nav-link {
      color: rgba(237, 248, 255, 0.74);
      transition: color 180ms ease, background 180ms ease;
    }

    .nav-link:hover,
    .nav-link.active {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
    }

    .robot-bob {
      animation: robotBob 2.5s ease-in-out infinite;
      filter: drop-shadow(0 0 22px rgba(0, 212, 255, 0.42));
    }

    .ambient {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .particle {
      position: absolute;
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--cyan), var(--violet));
      opacity: 0.5;
      animation: floatParticle 9s ease-in-out infinite;
    }

    .particle:nth-child(1) { left: 8%; top: 24%; animation-delay: 0s; }
    .particle:nth-child(2) { left: 20%; top: 74%; animation-delay: 1.5s; }
    .particle:nth-child(3) { left: 74%; top: 22%; animation-delay: 2.2s; }
    .particle:nth-child(4) { left: 88%; top: 68%; animation-delay: 3.2s; }
    .particle:nth-child(5) { left: 52%; top: 58%; animation-delay: 4.1s; }

    @keyframes robotBob {
      0%, 100% { transform: translateY(0) rotate(-2deg); }
      50% { transform: translateY(-10px) rotate(2deg); }
    }

    @keyframes floatParticle {
      0%, 100% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.35; }
      50% { transform: translate3d(16px, -30px, 0) scale(1.4); opacity: 0.75; }
    }
  </style>
</head>
<body>
  <nav class="sticky top-0 z-50 border-b border-white/10 bg-[#0f0f1a]/72 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-3 text-xl font-black tracking-wide">
        <span class="robot-bob inline-block">🤖</span>
        <span class="gradient-text">PoseAI</span>
      </a>
      <div class="flex flex-wrap items-center justify-end gap-2 text-sm font-semibold">
        <a class="nav-link <%= active === 'home' ? 'active' : '' %> rounded-full px-3 py-2" href="/">Bosh sahifa</a>
        <a class="nav-link <%= active === 'demo' ? 'active' : '' %> rounded-full px-3 py-2" href="/demo">Demo</a>
        <a class="nav-link <%= active === 'about' ? 'active' : '' %> rounded-full px-3 py-2" href="/about">Tizim haqida</a>
        <a class="nav-link <%= active === 'results' ? 'active' : '' %> rounded-full px-3 py-2" href="/results">Natijalar</a>
      </div>
    </div>
  </nav>

  <main class="relative z-10">
    <%- body %>
  </main>
</body>
</html>
